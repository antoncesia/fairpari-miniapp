# Скопируйте в bot/.env и впишите токен из @BotFather (/mybots → бот → API Token).
# Файл .env в репозиторий не попадает. Токен не пересылайте в чатах.
BOT_TOKEN=
APP_URL=https://antoncesia.github.io/fairpari-miniapp/
# Задержка приветственного бонуса после регистрации, секунд (по брифу 300)
BONUS_DELAY_SEC=300
